        <mxCell id="note0" value="• Đổi: nhận hàng cũ + hóa đơn mới. Trả: chỉ nhận hàng cũ và hoàn tiền." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#5b5362;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="2290" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="• Số lượng trả cộng dồn ≤ đã mua; hàng lỗi KHÔNG cộng vào tồn bán được." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#5b5362;fontSize=15;fontStyle=1;" vertex="1" parent="1">
