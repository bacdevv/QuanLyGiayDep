// 9 bảng. Tổng tiền được tính từ chi tiết hóa đơn.
Table NhanVien {
  maNhanVien varchar(12) [pk, not null]
  tenNhanVien nvarchar(100) [not null]
  soDienThoai varchar(15)
  hoatDong bit [not null]
}

Table TaiKhoan {
  maNhanVien varchar(12) [pk, not null]
  tenDangNhap varchar(50) [not null, unique]
  matKhauHash varchar(255) [not null]
}

Table DanhMuc {
  maDanhMuc varchar(12) [pk, not null]
  tenDanhMuc nvarchar(100) [not null, unique]
}

Table ThuongHieu {
  maThuongHieu varchar(12) [pk, not null]
  tenThuongHieu nvarchar(100) [not null, unique]
}

Table SanPham {
  maSP varchar(12) [pk, not null]
  maDanhMuc varchar(12) [not null]
  maThuongHieu varchar(12) [not null]
  tenSP nvarchar(150) [not null]
  hoatDong bit [not null]
}

Table ChiTietSanPham {
  maCTSP varchar(12) [pk, not null]
  maSP varchar(12) [not null]
  kichCo nvarchar(10) [not null]
  mauSac nvarchar(30) [not null]
  giaBan decimal(18,0) [not null]
  soLuongTon int [not null]
  hoatDong bit [not null]
  indexes {
    (maSP, kichCo, mauSac) [unique]
  }
}

Table KhachHang {
  maKH varchar(12) [pk, not null]
  tenKH nvarchar(100) [not null]
  soDienThoai varchar(15)
}

Table HoaDon {
  maHD varchar(12) [pk, not null]
  maNhanVien varchar(12) [not null]
  maKH varchar(12)
  ngayLap datetime2(0) [not null]
  phuongThucThanhToan varchar(20) [not null]
}

Table ChiTietHoaDon {
  maHD varchar(12) [not null]
  maCTSP varchar(12) [not null]
  soLuong int [not null]
  donGia decimal(18,0) [not null]
  indexes {
    (maHD, maCTSP) [pk]
  }
}

Ref: TaiKhoan.maNhanVien - NhanVien.maNhanVien
Ref: SanPham.maDanhMuc > DanhMuc.maDanhMuc
Ref: SanPham.maThuongHieu > ThuongHieu.maThuongHieu
Ref: ChiTietSanPham.maSP > SanPham.maSP
Ref: HoaDon.maNhanVien > NhanVien.maNhanVien
Ref: HoaDon.maKH > KhachHang.maKH
Ref: ChiTietHoaDon.maHD > HoaDon.maHD
Ref: ChiTietHoaDon.maCTSP > ChiTietSanPham.maCTSP
